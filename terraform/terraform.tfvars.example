# Copy this file to terraform.tfvars and fill in your values
# DO NOT commit terraform.tfvars — it contains secrets

aws_region        = "us-west-2"
project_name      = "ai-slug-navigator"
domain_name       = "aislugnavigator.com"
ec2_instance_type = "t3.micro"
ec2_key_name      = "ai-slug-navigator"

# Your home/office IP for emergency SSH access — find with `curl ifconfig.me`.
# Deploys go through SSM, not SSH, so this only needs to cover human access.
ssh_allowed_cidr = "203.0.113.5/32"

# Secrets — get these from your Supabase and Google Cloud dashboards
database_url   = "postgresql://..."
direct_url     = "postgresql://..."
jwt_secret     = "your-supabase-jwt-secret"
gemini_api_key = "your-gemini-api-key"
